# Test Environment Variables
# 테스트 환경용 설정입니다

# ==========================================================================
# 애플리케이션 설정
# ==========================================================================

NEXT_PUBLIC_APP_NAME=Next.js App (Test)
NEXT_PUBLIC_APP_VERSION=1.0.0-test
NEXT_PUBLIC_APP_DESCRIPTION=Next.js 16 Testing Environment

# ==========================================================================
# API 설정
# ==========================================================================

# MSW (Mock Service Worker) 사용을 위한 설정
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_TIMEOUT=5000
NEXT_PUBLIC_API_RETRY_COUNT=1

# ==========================================================================
# 인증 설정
# ==========================================================================

NEXT_PUBLIC_ACCESS_TOKEN_EXPIRY=1
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=1
NEXT_PUBLIC_LOGIN_PERSISTENCE_DEFAULT=session

# ==========================================================================
# OAuth 설정 (테스트용 모의 값)
# ==========================================================================

NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=test-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=test-google-secret

NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=test-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=test-github-secret

NEXT_PUBLIC_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# ==========================================================================
# 데이터베이스 설정 (테스트용)
# ==========================================================================

DATABASE_URL=postgresql://test:test@localhost:5432/app_test

DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# ==========================================================================
# Redis 설정 (테스트용 - 선택사항)
# ==========================================================================

# 테스트에서는 Redis를 사용하지 않을 수도 있습니다
REDIS_URL=

# ==========================================================================
# Feature Flags (테스트용 - 모두 활성화)
# ==========================================================================

NEXT_PUBLIC_FEATURE_ADVANCED_FILTERS=true
NEXT_PUBLIC_FEATURE_DARK_MODE=true
NEXT_PUBLIC_FEATURE_REALTIME_NOTIFICATIONS=true
NEXT_PUBLIC_FEATURE_PERFORMANCE_MONITORING=false

# ==========================================================================
# 개발 도구 설정 (테스트용)
# ==========================================================================

NEXT_PUBLIC_STORYBOOK_ENABLED=false
NEXT_PUBLIC_REDUX_DEVTOOLS=false
NEXT_PUBLIC_LOG_LEVEL=error

# ==========================================================================
# 테스트용 추가 설정
# ==========================================================================

# 테스트 타임아웃 (ms)
NEXT_PUBLIC_TEST_TIMEOUT=10000

# 테스트용 mock 데이터 사용
NEXT_PUBLIC_USE_MOCK_DATA=true

# ==========================================================================
# CORS 설정 (테스트용)
# ==========================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6006

# ==========================================================================
# 기타 설정
# ==========================================================================

NEXT_PUBLIC_TIMEZONE=Asia/Seoul
NEXT_PUBLIC_LOCALE=ko-KR
NEXT_PUBLIC_CURRENCY=KRW
