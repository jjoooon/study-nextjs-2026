{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/features/*": [
        "./src/features/*"
      ],
      "@/shared/*": [
        "./src/shared/*"
      ],
      "@uiux/*": [
        "./src/shared/components/uiux/*"
      ],
      "@common/*": [
        "./src/shared/components/common/*"
      ],
      "@features/*": [
        "./src/shared/components/features/*"
      ],
      "@layout/*": [
        "./src/shared/components/layout/*"
      ],
      "@hooks/*": [
        "./src/shared/hooks/*"
      ],
      "@grid/*": [
        "./src/shared/components/grid/*"
      ],
      "@aggrid": [
        "./src/shared/components/agGridUtils/index.ts"
      ],
      "@atoms": [
        "./src/shared/components/atoms/index.ts"
      ],
      "@icons": [
        "./src/shared/components/icons/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
