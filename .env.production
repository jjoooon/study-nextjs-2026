# Production Environment Variables
# 프로덕션 환경용 설정입니다

# ==========================================================================
# 애플리케이션 설정
# ==========================================================================

NEXT_PUBLIC_APP_NAME=Next.js App
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Next.js 16 Production Application

# ==========================================================================
# API 설정
# ==========================================================================

# 프로덕션 API URL (환경에 맞게 변경하세요)
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_TIMEOUT=10000
NEXT_PUBLIC_API_RETRY_COUNT=3

# ==========================================================================
# 인증 설정
# ==========================================================================

NEXT_PUBLIC_ACCESS_TOKEN_EXPIRY=15
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=7
NEXT_PUBLIC_LOGIN_PERSISTENCE_DEFAULT=week

# ==========================================================================
# OAuth 설정 (프로덕션용 - 실제 값으로 변경하세요)
# ==========================================================================

# Google OAuth
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Kakao OAuth
NEXT_PUBLIC_KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# Naver OAuth
NEXT_PUBLIC_NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# OAuth 리다이렉트 URL
NEXT_PUBLIC_OAUTH_REDIRECT_URL=https://yourdomain.com/auth/callback

# ==========================================================================
# 데이터베이스 설정 (프로덕션용 - 실제 값으로 변경하세요)
# ==========================================================================

DATABASE_URL=postgresql://user:password@production-db:5432/dbname

DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# ==========================================================================
# Redis 설정 (프로덕션용 - 실제 값으로 변경하세요)
# ==========================================================================

REDIS_URL=redis://production-redis:6379
REDIS_PASSWORD=your-redis-password

# ==========================================================================
# Storage 설정 (프로덕션용 - 실제 값으로 변경하세요)
# ==========================================================================

NEXT_PUBLIC_AWS_S3_BUCKET_NAME=your-bucket-name
NEXT_PUBLIC_AWS_REGION=ap-northeast-2
NEXT_PUBLIC_CLOUDFRONT_URL=https://cdn.yourdomain.com

# ==========================================================================
# Sentry 설정 (프로덕션용 - 실제 값으로 변경하세요)
# ==========================================================================

NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ==========================================================================
# Analytics 설정 (프로덕션용 - 실제 값으로 변경하세요)
# ==========================================================================

NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX

# ==========================================================================
# Feature Flags (프로덕션용 - 필요한 기능만 활성화)
# ==========================================================================

NEXT_PUBLIC_FEATURE_ADVANCED_FILTERS=true
NEXT_PUBLIC_FEATURE_DARK_MODE=true
NEXT_PUBLIC_FEATURE_REALTIME_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_PERFORMANCE_MONITORING=true

# ==========================================================================
# 개발 도구 설정 (프로덕션용 - 비활성화)
# ==========================================================================

NEXT_PUBLIC_STORYBOOK_ENABLED=false
NEXT_PUBLIC_REDUX_DEVTOOLS=false
NEXT_PUBLIC_LOG_LEVEL=error

# ==========================================================================
# 보안 설정 (프로덕션용)
# ==========================================================================

# CORS 허용된 오리진 (실제 도메인으로 변경하세요)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CSP 활성화
NEXT_PUBLIC_CSP_ENABLED=true

# ==========================================================================
# 캐시 설정 (프로덕션용)
# ==========================================================================

NEXT_PUBLIC_CACHE_EXPIRY=3600
NEXT_PUBLIC_STATIC_CACHE_ENABLED=true

# ==========================================================================
# 기타 설정
# ==========================================================================

NEXT_PUBLIC_TIMEZONE=Asia/Seoul
NEXT_PUBLIC_LOCALE=ko-KR
NEXT_PUBLIC_CURRENCY=KRW
