{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "build:dev": "env-cmd -f .env.development next build",
    "build:stg": "env-cmd -f .env.staging next build",
    "build:prd": "env-cmd -f .env.production next build",
    "start": "next start -p 3000",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "analyze": "next experimental-analyze",
    "sync:ia": "node -e \"require('fs').copyFileSync('src/stories/iaDashboard/ialist.json', 'public/ialist.json')\"",
    "prestorybook": "npm run sync:ia",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run sync:ia",
    "build-storybook": "storybook build",
    "export:pdf": "node scripts/storybook-to-pdf.js"
  },
