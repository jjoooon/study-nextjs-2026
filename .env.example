# Environment Variables Template
# 복사하여 .env.local 또는 .env.development 파일로 사용하세요

# ==========================================================================
# 애플리케이션 설정
# ==========================================================================

# 애플리케이션 이름
NEXT_PUBLIC_APP_NAME=Next.js App

# 애플리케이션 버전
NEXT_PUBLIC_APP_VERSION=1.0.0

# 애플리케이션 설명
NEXT_PUBLIC_APP_DESCRIPTION=Next.js 16 with TypeScript and Redux Toolkit

# ==========================================================================
# API 설정
# ==========================================================================

# API 기본 URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# API 타임아웃 (ms)
NEXT_PUBLIC_API_TIMEOUT=10000

# API 재시도 횟수
NEXT_PUBLIC_API_RETRY_COUNT=3

# ==========================================================================
# 인증 설정
# ==========================================================================

# JWT 액세스 토큰 만료 시간 (분)
NEXT_PUBLIC_ACCESS_TOKEN_EXPIRY=15

# JWT 리프레시 토큰 만료 시간 (일)
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=7

# 로그인 상태 유지 옵션 (session | week | month)
NEXT_PUBLIC_LOGIN_PERSISTENCE_DEFAULT=session

# ==========================================================================
# OAuth 설정
# ==========================================================================

# Google OAuth
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Kakao OAuth
NEXT_PUBLIC_KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# Naver OAuth
NEXT_PUBLIC_NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# OAuth 리다이렉트 URL
NEXT_PUBLIC_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# ==========================================================================
# 데이터베이스 설정 (서버 전용)
# ==========================================================================

# 데이터베이스 URL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# 데이터베이스 연결 풀
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==========================================================================
# Redis 설정 (선택)
# ==========================================================================

# Redis URL
REDIS_URL=redis://localhost:6379

# Redis 비밀번호
REDIS_PASSWORD=

# ==========================================================================
# Storage 설정 (선택)
# ==========================================================================

# AWS S3 버킷 이름
NEXT_PUBLIC_AWS_S3_BUCKET_NAME=

# AWS 리전
NEXT_PUBLIC_AWS_REGION=ap-northeast-2

# AWS CloudFront 배포 URL
NEXT_PUBLIC_CLOUDFRONT_URL=

# ==========================================================================
# 이메일 설정 (서버 전용)
# ==========================================================================

# SMTP 호스트
SMTP_HOST=smtp.gmail.com

# SMTP 포트
SMTP_PORT=587

# SMTP 사용자
SMTP_USER=

# SMTP 비밀번호
SMTP_PASSWORD=

# 발신자 이메일
SMTP_FROM_EMAIL=noreply@example.com

# 발신자 이름
SMTP_FROM_NAME=Next.js App

# ==========================================================================
# Sentry 설정 (선택)
# ==========================================================================

# Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=

# Sentry 환경
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ==========================================================================
# Analytics 설정 (선택)
# ==========================================================================

# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# Google Tag Manager ID
NEXT_PUBLIC_GTM_ID=

# ==========================================================================
# Feature Flags
# ==========================================================================

# 고급 필터링 활성화
NEXT_PUBLIC_FEATURE_ADVANCED_FILTERS=false

# 다크 모드 활성화
NEXT_PUBLIC_FEATURE_DARK_MODE=true

# 실시간 알림 활성화
NEXT_PUBLIC_FEATURE_REALTIME_NOTIFICATIONS=false

# 성능 모니터링 활성화
NEXT_PUBLIC_FEATURE_PERFORMANCE_MONITORING=true

# ==========================================================================
# 개발 도구 설정
# ==========================================================================

# Storybook 활성화 (development 모드)
NEXT_PUBLIC_STORYBOOK_ENABLED=true

# Redux DevTools 활성화
NEXT_PUBLIC_REDUX_DEVTOOLS=true

# 로깅 레벨 (error | warn | info | debug)
NEXT_PUBLIC_LOG_LEVEL=debug

# ==========================================================================
# 보안 설정
# ==========================================================================

# CORS 허용된 오리진 (콤마로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6006

# CSP (Content Security Policy) 활성화
NEXT_PUBLIC_CSP_ENABLED=false

# ==========================================================================
# 캐시 설정
# ==========================================================================

# 캐시 만료 시간 (초)
NEXT_PUBLIC_CACHE_EXPIRY=3600

# 정적 리소스 캐시 활성화
NEXT_PUBLIC_STATIC_CACHE_ENABLED=true

# ==========================================================================
# Pagination 설정
# ==========================================================================

# 기본 페이지 크기
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# 최대 페이지 크기
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# ==========================================================================
# 파일 업로드 설정
# ==========================================================================

# 최대 파일 크기 (bytes)
NEXT_PUBLIC_MAX_FILE_SIZE=52428800

# 허용된 이미지 형식 (콤마로 구분)
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# 허용된 문서 형식 (콤마로 구분)
NEXT_PUBLIC_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword

# ==========================================================================
# 기타 설정
# ==========================================================================

# 타임존
NEXT_PUBLIC_TIMEZONE=Asia/Seoul

# 로케일
NEXT_PUBLIC_LOCALE=ko-KR

# 통화 기호
NEXT_PUBLIC_CURRENCY=KRW
