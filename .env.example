# Development Environment Variables
# 개발 환경용 설정입니다

# ==========================================================================
# 애플리케이션 설정
# ==========================================================================

NEXT_PUBLIC_APP_NAME=Next.js App (Dev)
NEXT_PUBLIC_APP_VERSION=1.0.0-dev
NEXT_PUBLIC_APP_DESCRIPTION=Next.js 16 Development Environment

# ==========================================================================
# API 설정
# ==========================================================================

NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_TIMEOUT=10000
NEXT_PUBLIC_API_RETRY_COUNT=3

# ==========================================================================
# 인증 설정
# ==========================================================================

NEXT_PUBLIC_ACCESS_TOKEN_EXPIRY=15
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=7
NEXT_PUBLIC_LOGIN_PERSISTENCE_DEFAULT=session

# ==========================================================================
# OAuth 설정 (개발용)
# ==========================================================================

# Google OAuth (개발용)
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-dev
GOOGLE_OAUTH_CLIENT_SECRET=your-google-secret-dev

# GitHub OAuth (개발용)
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=your-github-client-id-dev
GITHUB_OAUTH_CLIENT_SECRET=your-github-secret-dev

# OAuth 리다이렉트 URL
NEXT_PUBLIC_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# ==========================================================================
# 데이터베이스 설정 (개발용)
# ==========================================================================

# 로컬 개발 데이터베이스
DATABASE_URL=postgresql://dev:dev@localhost:5432/app_dev

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==========================================================================
# Redis 설정 (개발용)
# ==========================================================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ==========================================================================
# Feature Flags (개발용 - 모든 기능 활성화)
# ==========================================================================

NEXT_PUBLIC_FEATURE_ADVANCED_FILTERS=true
NEXT_PUBLIC_FEATURE_DARK_MODE=true
NEXT_PUBLIC_FEATURE_REALTIME_NOTIFICATIONS=true
NEXT_PUBLIC_FEATURE_PERFORMANCE_MONITORING=true

# ==========================================================================
# 개발 도구 설정
# ==========================================================================

NEXT_PUBLIC_STORYBOOK_ENABLED=true
NEXT_PUBLIC_REDUX_DEVTOOLS=true
NEXT_PUBLIC_LOG_LEVEL=debug

# ==========================================================================
# CORS 설정 (개발용 - 완화된 설정)
# ==========================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6006

# ==========================================================================
# 기타 설정
# ==========================================================================

NEXT_PUBLIC_TIMEZONE=Asia/Seoul
NEXT_PUBLIC_LOCALE=ko-KR
NEXT_PUBLIC_CURRENCY=KRW
